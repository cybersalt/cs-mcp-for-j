<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_CSMCPFORJ_LOGS_FILTER_SEARCH"
			description="COM_CSMCPFORJ_LOGS_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field name="status" type="list" label="COM_CSMCPFORJ_LOGS_FILTER_STATUS" onchange="this.form.submit();">
			<option value="">COM_CSMCPFORJ_LOGS_FILTER_STATUS_ANY</option>
			<option value="problems">COM_CSMCPFORJ_LOGS_FILTER_STATUS_PROBLEMS</option>
			<option value="success">COM_CSMCPFORJ_LOGS_STATUS_SUCCESS</option>
			<option value="info">COM_CSMCPFORJ_LOGS_STATUS_INFO</option>
			<option value="warning">COM_CSMCPFORJ_LOGS_STATUS_WARNING</option>
			<option value="error">COM_CSMCPFORJ_LOGS_STATUS_ERROR</option>
		</field>

		<field name="source" type="list" label="COM_CSMCPFORJ_LOGS_FILTER_SOURCE" onchange="this.form.submit();">
			<option value="">COM_CSMCPFORJ_LOGS_FILTER_SOURCE_ANY</option>
			<option value="oauth">COM_CSMCPFORJ_LOGS_SOURCE_OAUTH</option>
			<option value="auth">COM_CSMCPFORJ_LOGS_SOURCE_AUTH</option>
			<option value="mcp">COM_CSMCPFORJ_LOGS_SOURCE_MCP</option>
		</field>

		<field name="event" type="list" label="COM_CSMCPFORJ_LOGS_FILTER_EVENT" onchange="this.form.submit();">
			<option value="">COM_CSMCPFORJ_LOGS_FILTER_EVENT_ANY</option>
			<option value="oauth.discovery">oauth.discovery</option>
			<option value="oauth.register">oauth.register</option>
			<option value="oauth.authorize">oauth.authorize</option>
			<option value="oauth.token">oauth.token</option>
			<option value="oauth.revoke">oauth.revoke</option>
			<option value="auth.challenge">auth.challenge</option>
			<option value="auth.token">auth.token</option>
			<option value="initialize">initialize</option>
			<option value="tools/call">tools/call</option>
			<option value="tools/list">tools/list</option>
			<option value="request">request</option>
		</field>

		<field name="since" type="list" label="COM_CSMCPFORJ_LOGS_FILTER_SINCE" onchange="this.form.submit();">
			<option value="">COM_CSMCPFORJ_LOGS_FILTER_SINCE_ANY</option>
			<option value="1h">COM_CSMCPFORJ_LOGS_FILTER_SINCE_1H</option>
			<option value="24h">COM_CSMCPFORJ_LOGS_FILTER_SINCE_24H</option>
			<option value="7d">COM_CSMCPFORJ_LOGS_FILTER_SINCE_7D</option>
			<option value="30d">COM_CSMCPFORJ_LOGS_FILTER_SINCE_30D</option>
		</field>

		<field name="user_id" type="user" label="COM_CSMCPFORJ_LOGS_FILTER_USER" onchange="this.form.submit();" />

		<field name="request_id" type="text" label="COM_CSMCPFORJ_LOGS_FILTER_REQUEST" hint="COM_CSMCPFORJ_LOGS_FILTER_REQUEST" onchange="this.form.submit();" />
	</fields>

	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.id DESC" onchange="this.form.submit();">
			<option value="a.id DESC">COM_CSMCPFORJ_LOGS_SORT_NEWEST</option>
			<option value="a.id ASC">COM_CSMCPFORJ_LOGS_SORT_OLDEST</option>
			<option value="a.elapsed_ms DESC">COM_CSMCPFORJ_LOGS_SORT_SLOWEST</option>
			<option value="a.status ASC">COM_CSMCPFORJ_LOGS_SORT_STATUS</option>
			<option value="a.subject ASC">COM_CSMCPFORJ_LOGS_SORT_SUBJECT</option>
		</field>

		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="50" onchange="this.form.submit();" />
	</fields>
</form>
