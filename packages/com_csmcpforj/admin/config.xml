<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset
		name="catalog"
		label="COM_CSMCPFORJ_CONFIG_CATALOG_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_CATALOG_FIELDSET_DESC"
	>
		<field
			name="catalog_url"
			type="url"
			label="COM_CSMCPFORJ_CONFIG_CATALOG_URL_LABEL"
			description="COM_CSMCPFORJ_CONFIG_CATALOG_URL_DESC"
			default="https://www.cybersalt.com/index.php?option=com_csreleasemanager&amp;task=api.catalog&amp;format=json&amp;catalog=cs-mcp-for-j"
			filter="url"
			size="80"
		/>

		<field
			name="cache_ttl_hours"
			type="integer"
			label="COM_CSMCPFORJ_CONFIG_CATALOG_CACHE_TTL_LABEL"
			description="COM_CSMCPFORJ_CONFIG_CATALOG_CACHE_TTL_DESC"
			default="24"
			first="1"
			last="168"
			step="1"
		/>

		<field
			name="catalog_show_pro_unavailable"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_CATALOG_SHOW_PRO_LABEL"
			description="COM_CSMCPFORJ_CONFIG_CATALOG_SHOW_PRO_DESC"
			default="1"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field
			name="pro_recheck_seconds"
			type="integer"
			label="COM_CSMCPFORJ_CONFIG_PRO_RECHECK_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_RECHECK_DESC"
			default="86400"
			first="60"
			last="604800"
			step="60"
		/>
	</fieldset>

	<fieldset
		name="server"
		label="COM_CSMCPFORJ_CONFIG_SERVER_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_SERVER_FIELDSET_DESC"
	>
		<field
			name="read_only_mode"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_READ_ONLY_LABEL"
			description="COM_CSMCPFORJ_CONFIG_READ_ONLY_DESC"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<!-- Per-group tool sets (Michel Campaner, 2026-11-20): staff in a group can
	     be limited to some tool domains (content + media, say), optionally
	     read-only. Read by MCP\ToolAccess on every request. -->
	<fieldset
		name="toolaccess"
		label="COM_CSMCPFORJ_CONFIG_TOOLACCESS_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_TOOLACCESS_FIELDSET_DESC"
		addfieldprefix="Cybersalt\Component\Csmcpforj\Administrator\Field"
	>
		<field
			name="tool_access_note"
			type="note"
			description="COM_CSMCPFORJ_CONFIG_TOOLACCESS_NOTE"
			class="alert alert-info"
		/>
		<field
			name="tool_access_rules"
			type="subform"
			label="COM_CSMCPFORJ_CONFIG_TOOLACCESS_RULES_LABEL"
			description="COM_CSMCPFORJ_CONFIG_TOOLACCESS_RULES_DESC"
			multiple="true"
			layout="joomla.form.field.subform.repeatable"
			buttons="add,remove"
		>
			<form addfieldprefix="Cybersalt\Component\Csmcpforj\Administrator\Field">
				<field
					name="group"
					type="usergrouplist"
					label="COM_CSMCPFORJ_CONFIG_TOOLACCESS_GROUP_LABEL"
					description="COM_CSMCPFORJ_CONFIG_TOOLACCESS_GROUP_DESC"
					filter="integer"
				>
					<option value="">COM_CSMCPFORJ_CONFIG_TOOLACCESS_GROUP_SELECT</option>
				</field>
				<field
					name="domains"
					type="ToolDomains"
					label="COM_CSMCPFORJ_CONFIG_TOOLACCESS_DOMAINS_LABEL"
					description="COM_CSMCPFORJ_CONFIG_TOOLACCESS_DOMAINS_DESC"
					multiple="true"
					layout="joomla.form.field.list-fancy-select"
				/>
				<field
					name="tools"
					type="text"
					label="COM_CSMCPFORJ_CONFIG_TOOLACCESS_TOOLS_LABEL"
					description="COM_CSMCPFORJ_CONFIG_TOOLACCESS_TOOLS_DESC"
					filter="string"
				/>
				<field
					name="read_only"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="COM_CSMCPFORJ_CONFIG_TOOLACCESS_READ_ONLY_LABEL"
					description="COM_CSMCPFORJ_CONFIG_TOOLACCESS_READ_ONLY_DESC"
					default="0"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</form>
		</field>
	</fieldset>

	<!-- Uploads through the Media tools and the upload link page. Joomla's own
	     Media settings (allowed extensions, MIME types, maximum size) still
	     apply; these narrow them and process images. Read by
	     Helper\MediaUploadHelper. -->
	<fieldset
		name="media"
		label="COM_CSMCPFORJ_CONFIG_MEDIA_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_MEDIA_FIELDSET_DESC"
	>
		<field
			name="media_max_upload_mb"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_MAX_MB_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_MAX_MB_DESC"
			default="20"
			min="1"
			max="200"
			filter="integer"
		/>
		<field
			name="media_process_images"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_PROCESS_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_PROCESS_DESC"
			default="1"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="media_fix_orientation"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_ORIENTATION_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_ORIENTATION_DESC"
			default="1"
			showon="media_process_images:1"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="media_max_dimension"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_MAX_DIMENSION_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_MAX_DIMENSION_DESC"
			default="2560"
			min="0"
			max="10000"
			filter="integer"
			showon="media_process_images:1"
		/>
		<field
			name="media_strip_metadata"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_STRIP_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_STRIP_DESC"
			default="1"
			showon="media_process_images:1"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="media_convert_webp"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_WEBP_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_WEBP_DESC"
			default="0"
			showon="media_process_images:1"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="media_jpeg_quality"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_JPEG_QUALITY_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_JPEG_QUALITY_DESC"
			default="85"
			min="40"
			max="100"
			filter="integer"
			showon="media_process_images:1"
		/>
		<field
			name="media_webp_quality"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_WEBP_QUALITY_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_WEBP_QUALITY_DESC"
			default="82"
			min="40"
			max="100"
			filter="integer"
			showon="media_process_images:1[AND]media_convert_webp:1"
		/>
		<field
			name="media_upload_link_minutes"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_LINK_MINUTES_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_LINK_MINUTES_DESC"
			default="30"
			min="5"
			max="1440"
			filter="integer"
		/>
		<field
			name="media_allow_svg"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_MEDIA_SVG_LABEL"
			description="COM_CSMCPFORJ_CONFIG_MEDIA_SVG_DESC"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset
		name="oauth"
		label="COM_CSMCPFORJ_CONFIG_OAUTH_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_OAUTH_FIELDSET_DESC"
	>
		<field
			name="oauth_enabled"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_CSMCPFORJ_CONFIG_OAUTH_ENABLED_LABEL"
			description="COM_CSMCPFORJ_CONFIG_OAUTH_ENABLED_DESC"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="oauth_access_ttl"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_OAUTH_ACCESS_TTL_LABEL"
			description="COM_CSMCPFORJ_CONFIG_OAUTH_ACCESS_TTL_DESC"
			default="3600"
			min="300"
			max="86400"
			step="60"
			showon="oauth_enabled:1"
		/>
		<field
			name="oauth_refresh_days"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_OAUTH_REFRESH_DAYS_LABEL"
			description="COM_CSMCPFORJ_CONFIG_OAUTH_REFRESH_DAYS_DESC"
			default="30"
			min="1"
			max="365"
			showon="oauth_enabled:1"
		/>
	</fieldset>

	<fieldset
		name="logging"
		label="COM_CSMCPFORJ_CONFIG_LOGGING_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_LOGGING_FIELDSET_DESC"
	>
		<field
			name="log_level"
			type="list"
			label="COM_CSMCPFORJ_CONFIG_LOG_LEVEL_LABEL"
			description="COM_CSMCPFORJ_CONFIG_LOG_LEVEL_DESC"
			default="all"
			validate="options"
		>
			<option value="all">COM_CSMCPFORJ_CONFIG_LOG_LEVEL_ALL</option>
			<option value="problems">COM_CSMCPFORJ_CONFIG_LOG_LEVEL_PROBLEMS</option>
			<option value="off">COM_CSMCPFORJ_CONFIG_LOG_LEVEL_OFF</option>
		</field>
		<field
			name="log_retention_days"
			type="number"
			label="COM_CSMCPFORJ_CONFIG_LOG_RETENTION_LABEL"
			description="COM_CSMCPFORJ_CONFIG_LOG_RETENTION_DESC"
			default="30"
			min="1"
			max="365"
			filter="integer"
			showon="log_level!:off"
		/>
	</fieldset>

	<fieldset
		name="privacy"
		label="COM_CSMCPFORJ_CONFIG_PRIVACY_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_PRIVACY_FIELDSET_DESC"
	>
		<!--
		Controls how long an operator has to hover a blurred secret (Joomla
		API token on the Dashboard, Pro membership email) before it reveals.
		The blur exists so accidental screen shares / screencasts don't leak
		either. A short hover-then-reveal delay makes accidental reveal from
		a mouse-passing-through even less likely: users have to intentionally
		hold hover for the full delay before the secret becomes readable.

		default=3 — enough to defeat a casual mouse-over, short enough to
		feel snappy when you're deliberately trying to see it. Set to 0
		to disable the delay entirely (immediate reveal on hover, current
		behavior before the delay was added). Max 60 keeps the input honest.
		-->
		<field
			name="hover_reveal_delay_seconds"
			type="integer"
			label="COM_CSMCPFORJ_CONFIG_HOVER_REVEAL_DELAY_LABEL"
			description="COM_CSMCPFORJ_CONFIG_HOVER_REVEAL_DELAY_DESC"
			default="3"
			first="0"
			last="60"
			step="1"
		/>

		<!--
		Once a secret is revealed via hover-with-delay, this controls how
		many seconds it stays visible before auto-hiding back to the blurred
		state (without waiting for the operator to move the mouse away).
		Belt-and-braces for the screencasting use case: even if you glanced,
		read the token, and then got distracted while your mouse was still
		over it, the reveal doesn't stay open indefinitely.

		default=8 — long enough to read a full base64 token comfortably
		but short enough that an unattended session doesn't leave the
		secret exposed for minutes. Set to 0 to disable auto-hide (reveal
		persists until mouseleave, current pre-auto-hide behaviour). Max
		300 = five minutes; longer than that is functionally "no auto-hide".
		-->
		<field
			name="hover_reveal_hide_seconds"
			type="integer"
			label="COM_CSMCPFORJ_CONFIG_HOVER_REVEAL_HIDE_LABEL"
			description="COM_CSMCPFORJ_CONFIG_HOVER_REVEAL_HIDE_DESC"
			default="8"
			first="0"
			last="300"
			step="1"
		/>
	</fieldset>

	<!--
	Pro Membership / Activation — set by the Activate Pro flow in the dashboard,
	NOT meant to be edited by hand here. Listed for completeness so an operator
	can see / clear values if they get into a bad state. Read/write via
	ProActivationHelper at runtime.
	-->
	<fieldset
		name="pro"
		label="COM_CSMCPFORJ_CONFIG_PRO_FIELDSET_LABEL"
		description="COM_CSMCPFORJ_CONFIG_PRO_FIELDSET_DESC"
	>
		<field
			name="pro_deactivate_note"
			type="note"
			label="COM_CSMCPFORJ_CONFIG_PRO_DEACTIVATE_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_DEACTIVATE_DESC"
		/>

		<field
			name="pro_installation_id"
			type="text"
			label="COM_CSMCPFORJ_CONFIG_PRO_INSTALLATION_ID_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_INSTALLATION_ID_DESC"
			readonly="true"
			filter="string"
		/>

		<field
			name="pro_email"
			type="email"
			label="COM_CSMCPFORJ_CONFIG_PRO_EMAIL_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_EMAIL_DESC"
			readonly="true"
			filter="string"
		/>

		<field
			name="pro_email_hash"
			type="text"
			label="COM_CSMCPFORJ_CONFIG_PRO_EMAIL_HASH_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_EMAIL_HASH_DESC"
			readonly="true"
			filter="string"
		/>

		<field
			name="pro_status"
			type="text"
			label="COM_CSMCPFORJ_CONFIG_PRO_STATUS_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_STATUS_DESC"
			readonly="true"
			filter="string"
		/>

		<field
			name="pro_renewal_url"
			type="url"
			label="COM_CSMCPFORJ_CONFIG_PRO_RENEWAL_URL_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_RENEWAL_URL_DESC"
			readonly="true"
			filter="url"
		/>

		<field
			name="pro_signup_url"
			type="url"
			label="COM_CSMCPFORJ_CONFIG_PRO_SIGNUP_URL_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_SIGNUP_URL_DESC"
			readonly="true"
			filter="url"
		/>

		<field
			name="pro_message"
			type="textarea"
			label="COM_CSMCPFORJ_CONFIG_PRO_MESSAGE_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_MESSAGE_DESC"
			readonly="true"
			rows="3"
			filter="string"
		/>

		<field
			name="pro_package_title"
			type="text"
			label="COM_CSMCPFORJ_CONFIG_PRO_PACKAGE_TITLE_LABEL"
			description="COM_CSMCPFORJ_CONFIG_PRO_PACKAGE_TITLE_DESC"
			readonly="true"
			filter="string"
		/>
	</fieldset>

	<!-- Standard Joomla Permissions tab: the only place to grant "Use MCP endpoint"
	     (csmcpforj.use) and "Write through MCP endpoint" (csmcpforj.write) from access.xml. -->
	<fieldset
		name="permissions"
		label="JCONFIG_PERMISSIONS_LABEL"
		description="JCONFIG_PERMISSIONS_DESC"
	>
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			filter="rules"
			validate="rules"
			component="com_csmcpforj"
			section="component"
		/>
	</fieldset>
</config>
